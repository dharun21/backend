# Replace the placeholders in your private .env file. Never commit .env.
# URL-encode reserved characters in the database password.
ZENGENAI_DATABASE_URL=postgresql+psycopg://zengenai_app:URL_ENCODED_PASSWORD@localhost:5432/zengenai

# Generate a private key with: py -c "import secrets; print(secrets.token_urlsafe(48))"
ZENGENAI_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Comma-separated trusted browser origins.
ZENGENAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local upload storage and API settings.
ZENGENAI_UPLOAD_DIR=./.data/uploads
ZENGENAI_MAX_UPLOAD_MB=20
ZENGENAI_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local ClamAV daemon. Set REQUIRE_MALWARE_SCAN=true in production.
ZENGENAI_CLAMAV_HOST=
ZENGENAI_CLAMAV_PORT=3310
ZENGENAI_REQUIRE_MALWARE_SCAN=false

# Optional free Gmail SMTP delivery. Enable 2-Step Verification and create an app password.
# If left blank, account creation still works and welcome email is skipped.
ZENGENAI_SMTP_HOST=smtp.gmail.com
ZENGENAI_SMTP_PORT=587
ZENGENAI_SMTP_USERNAME=
ZENGENAI_SMTP_PASSWORD=
ZENGENAI_SMTP_FROM_EMAIL=
ZENGENAI_SMTP_USE_SSL=false

# Public frontend URL used to build password-reset links (include the GitHub Pages base path if applicable).
ZENGENAI_FRONTEND_URL=http://localhost:5173/Ai-workforce-workspace
